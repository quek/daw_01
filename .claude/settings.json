{
  "permissions": {
    "additionalDirectories": ["F:/dev/gui_01"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash F:/dev/daw_01/.claude/hooks/sessionstart_show_pending_reflections.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File F:/dev/daw_01/scripts/check_antipattern.ps1",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File F:/dev/daw_01/scripts/check_compromise_smell.ps1",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File F:/dev/daw_01/scripts/log_metric.ps1",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File F:/dev/daw_01/scripts/release_build_on_commit.ps1",
            "if": "Bash(git *)",
            "timeout": 600,
            "statusMessage": "commit 後の release build を実行中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash F:/dev/daw_01/.claude/hooks/stop_session_reflect.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File F:/dev/daw_01/scripts/reflect.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
