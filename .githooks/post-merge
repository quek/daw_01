#!/bin/sh
# git-native post-merge hook: main への merge (fast-forward / no-ff) と pull で
# release build を走らせる。
#
# git は `git merge` / `git pull` で post-commit でなく post-merge を発火する
# (git 2.50 で実測: merge コミット生成でも post-commit は一切呼ばれない)。これが
# 無いと main への統合 merge が一度も release build されず、CLAUDE.md「commit したら
# 必ず release build」の保証に穴が空いていた (FIXME #66 の merge で発覚)。
#
# $1 = squash フラグ。squash merge はまだ commit が無く、後続の `git commit` が
# post-commit を発火するので、ここでは skip する (未 commit 状態を build しない)。
[ "$1" = "1" ] && exit 0

# 共通ロジックは lib/release_build_trigger.sh に集約 (post-commit と DRY)。
. "$(dirname "$0")/lib/release_build_trigger.sh"
